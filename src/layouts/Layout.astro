---
import '@/styles/globals.css';
import '@fontsource-variable/roboto-flex';

interface Props {
	title: string;
	lang?: string;
}

const { title, lang = 'es' } = Astro.props;
---

<!doctype html>
<html lang={lang} class="h-full dark bg-[#09090b]">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<meta name="description" content="Spotify Wrapped 2024 - La experiencia musical personalizada de Mr. Vinotinto" />
		<meta name="theme-color" content="#121212" />
		<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎵</text></svg>" />
		<title>{title}</title>
	</head>
	<body class="h-full overflow-x-hidden bg-[#0a0a0f] text-white antialiased selection:bg-[#1db954] selection:text-black">
		<main class="h-full w-full">
			<slot />
		</main>
	</body>
</html>
<style is:global>
	html {
		font-family: 'Roboto Flex Variable', sans-serif;
	}
</style>